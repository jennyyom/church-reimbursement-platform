rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 유저 본인 정보만 읽기/쓰기
    match /users/{userId} {
  allow read: if request.auth != null
    && (request.auth.uid == userId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
  allow write: if request.auth != null
    && request.auth.uid == userId;
  allow update: if request.auth != null
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'departmentId']);
	}

    // 교회 정보는 누구나 읽기 가능 (초대 코드 확인용)
    match /churches/{churchId} {
      allow read: if true;

      // adminPastorUid(2단계 승인자) 지정만 admin에게 허용.
      // inviteCode 등 다른 필드는 앱에서 못 건드리게 그대로 막아둠 - 교회 생성/설정 자체는
      // 앱 밖(콘솔 등)에서 하는 작업이라, 여기선 딱 이 한 필드만 예외적으로 열어줌
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminPastorUid']);

      allow create, delete: if false;
    }

    // 교회 expenses - 같은 교회 멤버만 접근
    match /churches/{churchId}/expenses/{expenseId} {

      // 읽기: 같은 교회 멤버
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId;

      // 쓰기: 본인 expense만
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // 승인/거절: role이 approver/admin이어도 그것만으로는 부족하고, 지금 이 지출의
      // 담당 tier로 실제 지정된 사람(approvalChain[currentTier-1].approverUid)만 가능.
      // admin이라고 무조건 통과시키지 않는 이유: "시스템을 관리할 권한"과 "이 지출을
      // 승인할 자격"은 서로 다른 문제라서 - admin이 대신 처리해야 하면 Departments 탭에서
      // 담당자를 공식적으로 재지정하는 절차를 거쳐야지, 뒷문으로 우회하면 안 됨.
      //
      // 본인 pending·rejected 건 수정: soft-delete(hiddenFromMember), 업로드 후 imageUrl 채우기,
      // draft 확정(draft/amount/description/departmentId/departmentName/approvalChain/currentTier) —
      // 그 외 필드(status, approvedBy 등)는 못 건드림
      allow update: if request.auth != null
        && ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['approver', 'admin']
                && resource.data.approvalChain[resource.data.currentTier - 1].approverUid == request.auth.uid)
            || (resource.data.uid == request.auth.uid
                && resource.data.status in ['pending', 'rejected']
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['hiddenFromMember', 'imageUrl', 'draft', 'amount', 'description', 'departmentId', 'departmentName', 'approvalChain', 'currentTier'])));

      // 삭제(진짜 삭제): admin만, 그리고 approved는 삭제 불가(지급 완료 기록은 앱에서 영구 보존)
      // member는 위 soft-delete만 가능, 감사 기록은 admin 쪽에 남음
      allow delete: if request.auth != null
        && resource.data.status != 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 교회 departments - 읽기는 같은 교회 멤버 전체, 쓰기(추가/삭제)는 admin만
    match /churches/{churchId}/departments/{deptId} {

      // 읽기: 같은 교회 멤버
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId;

      // 쓰기(추가/수정/삭제): admin만
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 교회 activityCodes - 전체 부서 공용 지출 코드. 읽기는 같은 교회 멤버 전체, 쓰기는 admin만
    match /churches/{churchId}/activityCodes/{codeId} {

      // 읽기: 같은 교회 멤버
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId;

      // 쓰기(추가/수정/삭제): admin만
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
