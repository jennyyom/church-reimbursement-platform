rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 유저 문서 - 여기 있는 role이 앱 전체 권한(member/approver/admin)의 기준이라
    // "누가 어떤 필드를 바꿀 수 있나"를 필드 단위로 좁혀둠.
    // 예전엔 본인에게 allow write(생성+수정+삭제 전부)를 열어둬서, member가 앱을 거치지 않고
    // Firestore에 직접 요청하면 자기 role을 'admin'으로 바꿀 수 있었음.
    // (규칙은 하나만 통과해도 허용이라, 아래 admin 전용 update가 있어도 못 막았음)
    match /users/{userId} {
  // 읽기: 본인 문서, 또는 admin
  allow read: if request.auth != null
    && (request.auth.uid == userId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
  // 가입: 본인 uid 문서만, signup_page가 저장하는 5개 필드만 허용 (몰래 다른 필드 못 끼워넣게).
  // role은 무조건 member로 시작해야 함 - 스스로 admin/approver로 가입하는 것 차단.
  // 부서는 admin이 배정하는 거라 가입 땐 비워둠. 실제로 있는 교회 id인지도 확인
  // (초대 코드가 맞는지는 아직 앱에서만 확인함 - 규칙에선 못 봄)
  // ※ 나중에 AppUser.toFirestore()에 필드를 추가하면 아래 hasOnly 목록에도 같이 추가하고,
  //   규칙을 앱보다 먼저 배포해야 가입이 안 깨짐
  allow create: if request.auth != null
    && request.auth.uid == userId
    && request.resource.data.keys().hasOnly(['name', 'email', 'churchId', 'role', 'departmentId'])
    && request.resource.data.role == 'member'
    && request.resource.data.departmentId == null
    && exists(/databases/$(database)/documents/churches/$(request.resource.data.churchId));
  // 본인 수정: 이름만 - role/churchId/departmentId/email은 본인이 못 건드림.
  // (지금 앱엔 이름 수정 화면이 없지만, 나중에 넣을 수 있게 name만 열어둠)
  allow update: if request.auth != null
    && request.auth.uid == userId
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
  // admin 수정: 같은 교회 사람의 role/부서만 (admin 페이지의 Users 탭 드롭다운이 쓰는 두 필드).
  // churchId 비교 - 다른 교회 admin이 우리 교회 사람 권한을 못 바꾸게.
  // role 값은 app_user.dart의 UserRole enum 3개만 허용 - 오타나 'superadmin' 같은 값 차단.
  // 위 본인 수정 규칙과는 "둘 중 하나만 맞으면 통과" 관계라, member가 role을 바꾸려 하면
  // 본인 규칙(name 아님)에서도, 여기(admin 아님)에서도 걸려서 거부됨
  allow update: if request.auth != null
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == resource.data.churchId
    && request.resource.data.role in ['member', 'approver', 'admin']
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'departmentId']);
  // 계정 문서는 아무도 못 지움. 규칙이 없어도 기본으로 막히지만, "깜빡한 게 아니라 일부러 막음"을
  // 남기려고 적어둠 (영수증/지출 삭제와는 별개 - 그건 아래 expenses 규칙에서 따로 다룸)
  allow delete: if false;
	}

    // 교회 정보는 누구나 읽기 가능 (초대 코드 확인용)
    match /churches/{churchId} {
      allow read: if true;

      // adminPastorUid(2단계 승인자), financeChairUid($500 초과 건의 3단계 승인자) 지정만 admin에게 허용.
      // inviteCode 등 다른 필드는 앱에서 못 건드리게 그대로 막아둠 - 교회 생성/설정 자체는
      // 앱 밖(콘솔 등)에서 하는 작업이라, 여기선 딱 이 두 필드만 예외적으로 열어줌
      // (admin 페이지의 _buildChurchApproverCard가 한 번에 한 필드씩만 쓰지만, hasOnly는
      //  "이 목록 안의 필드만 바뀌었는가"를 보는 거라 한 개만 바뀌어도 통과함)
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminPastorUid', 'financeChairUid']);

      allow create, delete: if false;
    }

    // 교회 expenses - 같은 교회 멤버만 접근
    match /churches/{churchId}/expenses/{expenseId} {

      // 읽기: 같은 교회 멤버
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId;

      // 쓰기: 본인 expense만
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // 승인/거절: role이 approver/admin이어도 그것만으로는 부족하고, 지금 이 지출의
      // 담당 tier로 실제 지정된 사람(approvalChain[currentTier-1].approverUid)만 가능.
      // admin이라고 무조건 통과시키지 않는 이유: "시스템을 관리할 권한"과 "이 지출을
      // 승인할 자격"은 서로 다른 문제라서 - admin이 대신 처리해야 하면 Departments 탭에서
      // 담당자를 공식적으로 재지정하는 절차를 거쳐야지, 뒷문으로 우회하면 안 됨.
      //
      // 본인 pending·rejected 건 수정: soft-delete(hiddenFromMember), 업로드 후 imageUrl 채우기,
      // draft 확정(draft/amount/description/departmentId/departmentName/approvalChain/currentTier) —
      // 그 외 필드(status, approvedBy 등)는 못 건드림
      allow update: if request.auth != null
        && ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['approver', 'admin']
                && resource.data.approvalChain[resource.data.currentTier - 1].approverUid == request.auth.uid)
            || (resource.data.uid == request.auth.uid
                && resource.data.status in ['pending', 'rejected']
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['hiddenFromMember', 'imageUrl', 'draft', 'amount', 'description', 'departmentId', 'departmentName', 'approvalChain', 'currentTier'])));

      // 삭제(진짜 삭제): admin만, 그리고 approved는 삭제 불가(지급 완료 기록은 앱에서 영구 보존)
      // member는 위 soft-delete만 가능, 감사 기록은 admin 쪽에 남음
      allow delete: if request.auth != null
        && resource.data.status != 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 교회 approvalActions - approver가 승인/거절할 때마다 "내가 이 지출을 처리했다"고
    // 남기는 개별 기록(History 탭이 이걸 기준으로 조회함). 한 번 남긴 기록을 나중에
    // 고치거나 지울 수 있으면 "누가 언제 뭘 처리했는지"에 대한 신뢰가 깨지므로
    // update/delete는 아예 막아둠 - 감사 로그는 추가만 되고 수정은 안 되는 게 맞음.
    match /churches/{churchId}/approvalActions/{actionId} {

      // 읽기: 본인이 남긴 기록이거나 admin만 (다른 approver의 처리 이력을
      // 마음대로 못 보게)
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
        && (resource.data.approverUid == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');

      // 생성: 같은 교회의 approver/admin만, 그리고 반드시 자기 자신 명의로만
      // (다른 사람 uid를 대신 써서 기록을 조작 못 하게)
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['approver', 'admin']
        && request.resource.data.approverUid == request.auth.uid;

      allow update, delete: if false;
    }

    // 교회 departments - 읽기는 같은 교회 멤버 전체, 쓰기(추가/삭제)는 admin만
    match /churches/{churchId}/departments/{deptId} {

      // 읽기: 같은 교회 멤버
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId;

      // 쓰기(추가/수정/삭제): admin만
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 교회 activityCodes - 전체 부서 공용 지출 코드. 읽기는 같은 교회 멤버 전체, 쓰기는 admin만
    match /churches/{churchId}/activityCodes/{codeId} {

      // 읽기: 같은 교회 멤버
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId;

      // 쓰기(추가/수정/삭제): admin만
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
